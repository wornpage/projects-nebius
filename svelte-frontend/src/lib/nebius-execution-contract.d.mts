import type { NebiusTask, NebiusContextItem } from './nebius-contract.mjs';
export const RUN_VERSION: 'browser-tool.v1';
export const RUN_LIMITS: Readonly<{ maxModelCalls: 2; maxSandboxRuns: 2; maxOutputTokens: 8000; sandboxSeconds: 30; runSeconds: 600; maxFileBytes: 32768; maxTotalFileBytes: 65536 }>;
export type RunStatus = 'queued' | 'generating' | 'checking' | 'repairing' | 'cancelling' | 'ready' | 'failed' | 'cancelled' | 'uncertain';
export type RunFile = { path: 'index.html' | 'app.js' | 'checks.cjs'; content: string };
export type RunInput = { version: typeof RUN_VERSION; packId: string; pack: NebiusTask; currentStatus: 'draft' | 'active'; context: NebiusContextItem[]; requestedModel: string; consent: true };
export type RunCheck = { attempt: number; operationId: string; checkpointId: string | null; exitCode: number; stdout: string; stderr: string; sourceDigest: string };
export type RunRecord = Omit<RunInput, 'consent'> & { id: string; status: RunStatus; attempt: number; createdAt: string; updatedAt: string; events: { at: string; message: string }[]; files: RunFile[]; checks: RunCheck[]; usage: { modelCalls: number; inputTokens: number | null; outputTokens: number | null }; error: string | null };
export type RunConfig = { available: true; version: typeof RUN_VERSION; requestedModel: string; limits: typeof RUN_LIMITS };
export const RUN_FILES: readonly RunFile['path'][];
export const RUN_STATUSES: readonly RunStatus[];
export const TERMINAL_RUN_STATUSES: readonly RunStatus[];
export function validRunId(value: unknown): value is string;
export function validRunKey(value: unknown): value is string;
export function validateRunInput(value: unknown): RunInput;
export function validateRunFiles(value: unknown): RunFile[];
export function validateRunRecord(value: unknown): RunRecord;
export function isRunConfig(value: unknown): value is RunConfig;
export function runSnapshotFromRecord(record: RunRecord): Omit<RunInput, 'consent'>;
export function runFilesDigest(files: RunFile[]): Promise<string>;
export function validateRunIntegrity(value: unknown): Promise<RunRecord>;
