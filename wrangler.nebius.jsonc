{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wornpage-nebius-example",
  "main": "worker/index.mjs",
  "keep_names": false,
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_request_signal"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/static-publish",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/nebius/*",
      "/_app/*",
      "/_app-r191/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "NEBIUS_BUDGET",
        "class_name": "NebiusBudget"
      },
      {
        "name": "NEBIUS_RUN_BUDGET",
        "class_name": "NebiusRunBudget"
      },
      {
        "name": "NEBIUS_RUNS",
        "class_name": "NebiusRun"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "NebiusBudget"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "NebiusRunBudget",
        "NebiusRun"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "NEBIUS_IP_RATE_LIMITER",
      "namespace_id": "3101",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "vars": {
    "NEBIUS_ENABLED": "false",
    "NEBIUS_EXECUTION_ENABLED": "false",
    "NEBIUS_ALLOWED_ORIGIN": "",
    "NEBIUS_MODEL_ROUTINE": "",
    "NEBIUS_MODEL_REASONING": "",
    "NEBIUS_DAILY_CALL_LIMIT": "20",
    "NEBIUS_DAILY_RUN_LIMIT": "3",
    "NEBIUS_SANDBOX_PROJECT_ID": "",
    "NEBIUS_SANDBOX_NODE_IMAGE_UUID": ""
  },
  "env": {
    "demo": {
      "name": "wornpage-nebius-demo-example",
      "workers_dev": false,
      "preview_urls": false,
      "durable_objects": {
        "bindings": [
          {
            "name": "NEBIUS_BUDGET",
            "class_name": "NebiusBudget"
          },
          {
            "name": "NEBIUS_RUN_BUDGET",
            "class_name": "NebiusRunBudget"
          },
          {
            "name": "NEBIUS_RUNS",
            "class_name": "NebiusRun"
          }
        ]
      },
      "ratelimits": [
        {
          "name": "NEBIUS_IP_RATE_LIMITER",
          "namespace_id": "3101",
          "simple": {
            "limit": 3,
            "period": 60
          }
        }
      ],
      "vars": {
        "NEBIUS_ENABLED": "false",
        "NEBIUS_EXECUTION_ENABLED": "false",
        "NEBIUS_ALLOWED_ORIGIN": "",
        "NEBIUS_MODEL_ROUTINE": "nvidia/Nemotron-3.5-Super-VL",
        "NEBIUS_MODEL_REASONING": "nvidia/Nemotron-3.5-Super-VL",
        "NEBIUS_DAILY_CALL_LIMIT": "20",
        "NEBIUS_DAILY_RUN_LIMIT": "3",
        "NEBIUS_SANDBOX_PROJECT_ID": "",
        "NEBIUS_SANDBOX_NODE_IMAGE_UUID": ""
      },
      "version_metadata": {
        "binding": "NEBIUS_VERSION"
      }
    }
  },
  "version_metadata": {
    "binding": "NEBIUS_VERSION"
  }
}
